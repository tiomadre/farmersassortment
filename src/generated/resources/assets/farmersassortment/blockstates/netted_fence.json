{
  "multipart": [
    {
      "apply": {
        "model": "farmersassortment:block/netted_fence_post"
      },
      "when": {
        "waterlogged": "false"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/netted_fence_side",
        "uvlock": true
      },
      "when": {
        "north": "true",
        "waterlogged": "false"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/netted_fence_side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true",
        "waterlogged": "false"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/netted_fence_side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true",
        "waterlogged": "false"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/netted_fence_side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "waterlogged": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/wet_netted_fence_post"
      },
      "when": {
        "waterlogged": "true"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/wet_netted_fence_side",
        "uvlock": true
      },
      "when": {
        "north": "true",
        "waterlogged": "true"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/wet_netted_fence_side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true",
        "waterlogged": "true"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/wet_netted_fence_side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true",
        "waterlogged": "true"
      }
    },
    {
      "apply": {
        "model": "farmersassortment:block/wet_netted_fence_side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "waterlogged": "true",
        "west": "true"
      }
    }
  ]
}